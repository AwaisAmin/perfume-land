# Copy to .env.local and fill in. Never commit real values.

# Server-side base URL of the CRM backend API (the site reads /api/public/site).
# If unset, the site always uses the bundled content in src/data/. If set but
# unreachable during `next build`, the build uses the bundled content; if
# unreachable at request time, the last good cached page keeps being served.
API_URL=http://localhost:4000

# Public origin of the CRM backend. Allowed in the CSP img-src and next/image
# remotePatterns so images uploaded through the CRM (/uploads/...) display.
# MUST exactly equal the backend's PUBLIC_BASE_URL (same scheme, host and port).
# Uploaded images on any other origin are replaced with the default bottle image.
# It is read at build time (CSP, image config, client bundle): after changing it,
# rebuild the site (npm run build / redeploy).
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Shared secret the backend sends in the x-revalidate-secret header when it
# calls POST /api/revalidate. Must match the backend's REVALIDATE_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=replace-with-a-random-64-char-hex-string
