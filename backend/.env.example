PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=perfume_land

PUBLIC_BASE_URL=http://localhost:4000
SITE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Express "trust proxy" setting: "false" (default, local dev), a number of
# hops (e.g. "1" behind a single reverse proxy/load balancer in production),
# or "true" to trust all hops (only behind a fully-controlled proxy).
TRUST_PROXY=false

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=replace-with-a-long-random-string
